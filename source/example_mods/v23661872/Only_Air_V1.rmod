{
  "$schema": "ruse-mod/v1",
  "id": "only-air-v1",
  "name": "Only Air",
  "version": "1.0.0",
  "author": "ct_center",
  "description": "ever wanted to play battles with no air? no artillery? no tanks or no infantry? than this is the mod for you! simple limitations to allow more gameplay and to not have the ai spam those damn fighter bombers!",
