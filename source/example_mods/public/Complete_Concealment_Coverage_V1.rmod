{
  "$schema": "ruse-mod/v1",
  "id": "complete-concealment-coverage-v1",
  "name": "Complete Concealment Coverage",
  "version": "1.0.3",
  "patches": [],
  "author": "LittleGroove",
  "description": "This Mod will cover every map entirely with the concealment flag so small units that could be concealed in forests will be concealed everywhere. This does not affect non-concealable units and they will function normally.\n\nMakes AI considerably harder to defeat without knowing where their recon is.\n\n\nIT IS RECOMMENDED TO ALWAYS HAVE THIS MOD CACHED AND AT THE VERY TOP OF THE MODS LIST\n\nIt can take an upwards of five (5) minutes to deploy this mod and cached mods lists only need generated once.\n\nIt may appear like nothing is happening on deployment, I assure you, it is deploying SDB patches all at once.",
  "sdb_patches": [
    {
      "dat": "Data/PC/190852/DataMap_Win.dat",
      "win": "datasmap/alpha/mapinfo.win",
      "grid_size": 2048,
      "layers": [
        {
          "bit": 8,
          "mask": ""
        }
      ]
    },
